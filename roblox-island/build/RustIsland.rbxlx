  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Animals</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Targeting = require(script.Parent.Targeting)
local WorldGen = require(script.Parent.WorldGen)

local Animals = {}

export type Animal = {
	kind: string,
	model: Model,
	health: number,
	goal: Vector3?,
	idleUntil: number,
	angryAt: Player?,
	angryUntil: number,
	lastAttack: number,
}

local rng = Random.new()
local animals: { [Model]: Animal } = {}

local folder = Instance.new("Folder")
folder.Name = "Animals"
folder.Parent = workspace

local function part(model: Model, size: Vector3, offset: CFrame, color: Color3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.Fabric
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = offset
	p.Parent = model
end

-- Built around the origin facing -Z, then moved into place with PivotTo.
local function buildBoar(): Model
	local model = Instance.new("Model")
	model.Name = "Boar"
	local fur = Color3.fromRGB(90, 62, 45)
	local dark = Color3.fromRGB(50, 35, 28)
	part(model, Vector3.new(2.6, 2.2, 4.4), CFrame.new(0, 2.1, 0), fur)
	part(model, Vector3.new(1.9, 1.7, 1.6), CFrame.new(0, 2.3, -2.7), fur)
	part(model, Vector3.new(1, 0.8, 0.6), CFrame.new(0, 2, -3.7), dark)
	part(model, Vector3.new(0.2, 0.2, 0.7), CFrame.new(-0.5, 1.7, -3.7), Color3.fromRGB(235, 230, 210))
	part(model, Vector3.new(0.2, 0.2, 0.7), CFrame.new(0.5, 1.7, -3.7), Color3.fromRGB(235, 230, 210))
	for _, x in { -0.9, 0.9 } do
		for _, z in { -1.5, 1.5 } do
			part(model, Vector3.new(0.6, 1.2, 0.6), CFrame.new(x, 0.6, z), dark)
		end
	end
	model.WorldPivot = CFrame.new()
	return model
end

function Animals.Spawn(kind: string)
	local ground = WorldGen.RandomSurface({ Enum.Material.Grass })
	if not ground then
		return
	end
	local model = buildBoar()
	model:PivotTo(CFrame.new(ground) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model:SetAttribute("Kind", kind)
	model.Parent = folder
	animals[model] = {
		kind = kind,
		model = model,
		health = Config.Animals[kind].Health,
		goal = nil,
		idleUntil = 0,
		angryAt = nil,
		angryUntil = 0,
		lastAttack = 0,
	}
end

function Animals.SpawnAll()
	for kind, def in Config.Animals do
		for _ = 1, def.Count do
			Animals.Spawn(kind)
		end
	end
end

function Animals.FindTarget(root: BasePart, range: number): (Animal?, number)
	local best, bestDistance = nil, math.huge
	for model, animal in animals do
		local distance = Targeting.InFront(root, model:GetPivot().Position, range)
		if distance and distance < bestDistance then
			best, bestDistance = animal, distance
		end
	end
	return best, bestDistance
end

local function flash(model: Model)
	local originals = {}
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			originals[p] = p.Color
			p.Color = Color3.fromRGB(200, 60, 60)
		end
	end
	task.delay(0.12, function()
		for p, color in originals do
			p.Color = color
		end
	end)
end

-- Returns the meat dropped if this hit killed the animal, otherwise 0.
function Animals.Damage(animal: Animal, amount: number, attacker: Player): number
	if not animals[animal.model] then
		return 0
	end
	local def = Config.Animals[animal.kind]
	animal.health -= amount
	if animal.health <= 0 then
		animals[animal.model] = nil
		animal.model:Destroy()
		task.delay(def.Respawn, Animals.Spawn, animal.kind)
		return def.Meat
	end
	animal.angryAt = attacker
	animal.angryUntil = os.clock() + def.AngryTime
	flash(animal.model)
	return 0
end

local function rootOf(player: Player?): BasePart?
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function pickWanderGoal(from: Vector3): Vector3?
	local angle = rng:NextNumber(0, math.pi * 2)
	local distance = rng:NextNumber(10, 30)
	local ground = WorldGen.GroundBelow(from + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance))
	if ground and ground.Y > Config.Island.SeaLevel + 1 then
		return ground
	end
	return nil
end

local function step(animal: Animal, dt: number, now: number)
	local def = Config.Animals[animal.kind]
	local position = animal.model:GetPivot().Position
	local speed = def.WalkSpeed
	local goal = animal.goal

	local enemy = if now < animal.angryUntil then rootOf(animal.angryAt) else nil
	if enemy and (enemy.Position - position).Magnitude < 80 then
		goal = enemy.Position
		speed = def.RunSpeed
		local reach = Vector3.new(enemy.Position.X - position.X, 0, enemy.Position.Z - position.Z).Magnitude
		if reach <= def.AttackRange and now - animal.lastAttack >= def.AttackCooldown then
			animal.lastAttack = now
			local humanoid = enemy.Parent and enemy.Parent:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:TakeDamage(def.Damage)
			end
		end
		if reach <= def.AttackRange * 0.8 then
			return
		end
	else
		animal.angryAt = nil
		if now < animal.idleUntil then
			return
		end
		if not goal then
			animal.goal = pickWanderGoal(position)
			if not animal.goal then
				animal.idleUntil = now + 1
			end
			return
		end
	end

	local flat = Vector3.new(goal.X - position.X, 0, goal.Z - position.Z)
	if flat.Magnitude < 1 then
		animal.goal = nil
		animal.idleUntil = now + rng:NextNumber(1, 5)
		return
	end

	local direction = flat.Unit
	local nextGround = WorldGen.GroundBelow(position + direction * math.min(speed * dt, flat.Magnitude))
	if not nextGround or nextGround.Y < Config.Island.SeaLevel + 0.5 then
		animal.goal = nil
		animal.idleUntil = now + 1
		return
	end
	animal.model:PivotTo(CFrame.lookAt(nextGround, nextGround + direction))
end

function Animals.Run()
	task.spawn(function()
		while true do
			local dt = task.wait(0.1)
			local now = os.clock()
			for _, animal in animals do
				step(animal, dt, now)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for _, animal in animals do
			if animal.angryAt == player then
				animal.angryAt = nil
			end
		end
	end)
end

return Animals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Builds</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Containers = require(script.Parent.Containers)
local WorldGen = require(script.Parent.WorldGen)

local Remotes = ReplicatedStorage.Remotes

local Builds = {}

local folder = Instance.new("Folder")
folder.Name = "Builds"
folder.Parent = workspace

local function anchoredPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

local makers = {}

function makers.Campfire(model: Model, base: CFrame)
	for i = 1, 8 do
		local angle = i / 8 * math.pi * 2
		anchoredPart({
			Size = Vector3.new(0.9, 0.7, 0.9),
			CFrame = base * CFrame.new(math.cos(angle) * 2, 0.35, math.sin(angle) * 2),
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(110, 110, 115),
		}).Parent = model
	end

	for i = 1, 3 do
		anchoredPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 0.6, 0.6),
			CFrame = base * CFrame.new(0, 0.4, 0) * CFrame.Angles(0, i / 3 * math.pi, 0),
			Material = Enum.Material.Wood,
			Color = Color3.fromRGB(80, 55, 35),
			CanCollide = false,
		}).Parent = model
	end

	local core = anchoredPart({
		Name = "Core",
		Size = Vector3.new(1, 1, 1),
		CFrame = base * CFrame.new(0, 0.8, 0),
		Transparency = 1,
		CanCollide = false,
	})
	core.Parent = model

	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 8
	fire.Parent = core

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 90)
	light.Range = 22
	light.Brightness = 2
	light.Parent = core
end

function makers.WoodWall(model: Model, base: CFrame)
	anchoredPart({
		Size = Vector3.new(10, 8, 1),
		CFrame = base * CFrame.new(0, 3.5, 0),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(140, 100, 60),
	}).Parent = model
end

local wallColor = Color3.fromRGB(140, 100, 60)

function makers.DoorWall(model: Model, base: CFrame, owner: Player)
	for _, x in { -3.5, 3.5 } do
		anchoredPart({
			Size = Vector3.new(3, 8, 1),
			CFrame = base * CFrame.new(x, 3.5, 0),
			Material = Enum.Material.WoodPlanks,
			Color = wallColor,
		}).Parent = model
	end
	anchoredPart({
		Size = Vector3.new(4, 1, 1),
		CFrame = base * CFrame.new(0, 7, 0),
		Material = Enum.Material.WoodPlanks,
		Color = wallColor,
	}).Parent = model

	local closed = base * CFrame.new(0, 3, 0)
	local hinge = base * CFrame.new(-2, 3, 0)
	local opened = hinge * CFrame.Angles(0, math.rad(-95), 0) * CFrame.new(2, 0, 0)

	local door = anchoredPart({
		Name = "Door",
		Size = Vector3.new(4, 7, 0.4),
		CFrame = closed,
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(105, 70, 40),
	})
	door.Parent = model

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Открыть"
	prompt.ObjectText = "Дверь"
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = door

	local isOpen = false
	prompt.Triggered:Connect(function(player)
		if player.UserId ~= owner.UserId then
			Remotes.Notify:FireClient(player, "Дверь заперта")
			return
		end
		isOpen = not isOpen
		prompt.ActionText = isOpen and "Закрыть" or "Открыть"
		TweenService:Create(door, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {
			CFrame = isOpen and opened or closed,
		}):Play()
	end)
end

function makers.Chest(model: Model, base: CFrame, owner: Player)
	local box = anchoredPart({
		Name = "Box",
		Size = Vector3.new(3.4, 1.8, 2.2),
		CFrame = base * CFrame.new(0, 0.9, 0),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(125, 85, 50),
	})
	box.Parent = model
	anchoredPart({
		Size = Vector3.new(3.6, 0.4, 2.4),
		CFrame = base * CFrame.new(0, 2, 0),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(95, 62, 38),
	}).Parent = model
	Containers.Register(model, box, "Ящик", owner.UserId)
end

-- Places a structure a few studs in front of the character, snapped to the ground.
function Builds.Place(player: Player, id: string): boolean
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not makers[id] then
		return false
	end

	local forward = root.CFrame.LookVector
	forward = Vector3.new(forward.X, 0, forward.Z).Unit
	local ground = WorldGen.GroundBelow(root.Position + forward * 7)
	if not ground then
		return false
	end

	local model = Instance.new("Model")
	model.Name = id
	model:SetAttribute("Owner", player.UserId)
	makers[id](model, CFrame.lookAt(ground, ground + forward), player)
	model.Parent = folder
	return true
end

function Builds.NearCampfire(position: Vector3, radius: number): boolean
	for _, model in folder:GetChildren() do
		if model.Name == "Campfire" and (model:GetPivot().Position - position).Magnitude <= radius then
			return true
		end
	end
	return false
end

return Builds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Containers</string>
          <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)

local Remotes = ReplicatedStorage.Remotes

local Containers = {}

type Container = {
	id: string,
	model: Model,
	title: string,
	owner: number?,
	items: { [string]: number },
	removeWhenEmpty: boolean,
	viewers: { [Player]: boolean },
}

local containers: { [string]: Container } = {}

local lootFolder = Instance.new("Folder")
lootFolder.Name = "LootBags"
lootFolder.Parent = workspace

local function canAccess(container: Container, player: Player): boolean
	return container.owner == nil or container.owner == player.UserId
end

local function isNear(container: Container, player: Player): boolean
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - container.model:GetPivot().Position).Magnitude <= 14
end

local function broadcast(container: Container)
	for viewer in container.viewers do
		if viewer.Parent then
			Remotes.Container:FireClient(viewer, "Update", container.id, container.items)
		end
	end
end

-- Makes `model` openable through a ProximityPrompt on `promptPart`.
-- `owner` is a UserId that may open it; nil means anyone can.
function Containers.Register(model: Model, promptPart: BasePart, title: string, owner: number?, items: { [string]: number }?, removeWhenEmpty: boolean?)
	local id = HttpService:GenerateGUID(false)
	local container: Container = {
		id = id,
		model = model,
		title = title,
		owner = owner,
		items = {},
		removeWhenEmpty = removeWhenEmpty == true,
		viewers = {},
	}
	for _, item in Config.Items do
		container.items[item] = items and items[item] or 0
	end
	containers[id] = container

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Открыть"
	prompt.ObjectText = title
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = promptPart

	prompt.Triggered:Connect(function(player)
		if not canAccess(container, player) then
			Remotes.Notify:FireClient(player, "Это чужой " .. string.lower(title))
			return
		end
		container.viewers[player] = true
		Remotes.Container:FireClient(player, "Open", id, container.items, title, model)
	end)

	model.Destroying:Connect(function()
		containers[id] = nil
		for viewer in container.viewers do
			if viewer.Parent then
				Remotes.Container:FireClient(viewer, "Close", id)
			end
		end
	end)
end

local function isEmpty(container: Container): boolean
	for _, amount in container.items do
		if amount > 0 then
			return false
		end
	end
	return true
end

-- Moves every unit of `item` between the player and the container.
function Containers.Transfer(player: Player, id: unknown, item: unknown, toContainer: boolean)
	local container = typeof(id) == "string" and containers[id]
	if not container or typeof(item) ~= "string" or container.items[item] == nil then
		return
	end
	if not canAccess(container, player) or not isNear(container, player) then
		return
	end

	if toContainer then
		local amount = PlayerData.GetItem(player, item)
		PlayerData.AddItem(player, item, -amount)
		container.items[item] += amount
	else
		local amount = container.items[item]
		container.items[item] = 0
		PlayerData.AddItem(player, item, amount)
	end

	broadcast(container)
	if container.removeWhenEmpty and isEmpty(container) then
		container.model:Destroy()
	end
end

function Containers.StopViewing(player: Player, id: unknown)
	local container = typeof(id) == "string" and containers[id]
	if container then
		container.viewers[player] = nil
	end
end

function Containers.DropLootBag(position: Vector3, items: { [string]: number }, ownerName: string)
	if next(items) == nil then
		return
	end

	local model = Instance.new("Model")
	model.Name = "LootBag"

	local bag = Instance.new("Part")
	bag.Name = "Bag"
	bag.Shape = Enum.PartType.Ball
	bag.Size = Vector3.new(2.2, 2.2, 2.2)
	bag.Color = Color3.fromRGB(120, 95, 60)
	bag.Material = Enum.Material.Fabric
	bag.Anchored = true
	bag.CanCollide = false
	bag.CFrame = CFrame.new(position + Vector3.new(0, 1, 0))
	bag.Parent = model

	model.Parent = lootFolder
	Containers.Register(model, bag, "Рюкзак " .. ownerName, nil, items, true)
	Debris:AddItem(model, Config.Survival.LootBagLifetime)
end

Players.PlayerRemoving:Connect(function(player)
	for _, container in containers do
		container.viewers[player] = nil
	end
end)

return Containers
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Animals = require(script.Parent.Animals)
local Builds = require(script.Parent.Builds)
local Containers = require(script.Parent.Containers)
local PlayerData = require(script.Parent.PlayerData)
local Resources = require(script.Parent.Resources)
local Shop = require(script.Parent.Shop)
local Targeting = require(script.Parent.Targeting)
local Tools = require(script.Parent.Tools)
local WorldGen = require(script.Parent.WorldGen)

local Remotes = ReplicatedStorage.Remotes
local survival = Config.Survival

local function notify(player: Player, text: string)
	Remotes.Notify:FireClient(player, text)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function findPlayerTarget(attacker: Player, root: BasePart): (Humanoid?, number)
	local best, bestDistance = nil, math.huge
	for _, other in Players:GetPlayers() do
		local otherRoot = other ~= attacker and rootOf(other)
		local humanoid = otherRoot and otherRoot.Parent:FindFirstChildOfClass("Humanoid")
		if otherRoot and humanoid and humanoid.Health > 0 then
			local distance = Targeting.InFront(root, otherRoot.Position, Config.MeleeRange)
			if distance and distance < bestDistance then
				best, bestDistance = humanoid, distance
			end
		end
	end
	return best, bestDistance
end

local function onSwing(player: Player, _tool: Tool, toolId: string)
	local root = rootOf(player)
	if not root then
		return
	end
	local def = Config.Tools[toolId]

	local victim, victimDistance = nil, math.huge
	if Config.PvP then
		victim, victimDistance = findPlayerTarget(player, root)
	end
	local animal, animalDistance = Animals.FindTarget(root, Config.MeleeRange)

	if victim and victimDistance <= animalDistance then
		victim:TakeDamage(def.Damage)
		return
	end

	if animal then
		local meat = Animals.Damage(animal, def.Damage, player)
		if meat > 0 then
			PlayerData.AddItem(player, "Meat", meat)
			notify(player, string.format("+%d %s", meat, Config.ItemNames.Meat))
		end
		return
	end

	local target = Resources.FindTarget(root, Config.GatherRange)
	if not target then
		return
	end
	local item, amount = Resources.Hit(target, def.Yield)
	if item and amount > 0 then
		if Shop.Has(player, "VIP") then
			amount *= Config.VipYieldMultiplier
		end
		PlayerData.AddItem(player, item, amount)
		notify(player, string.format("+%d %s", amount, Config.ItemNames[item]))
	elseif item then
		notify(player, "Этим инструментом тут ничего не добыть")
	end
end

local function giveTool(player: Player, id: string)
	Tools.Create(id, onSwing).Parent = player:WaitForChild("Backpack")
end

local function craft(player: Player, recipeId: string)
	local recipe
	for _, r in Config.Recipes do
		if r.Id == recipeId then
			recipe = r
		end
	end
	if not recipe then
		return
	end
	if not PlayerData.CanAfford(player, recipe.Cost) then
		notify(player, "Не хватает ресурсов")
		return
	end

	if recipe.Kind == "Tool" then
		if PlayerData.HasTool(player, recipe.Id) then
			notify(player, "У тебя уже есть " .. recipe.Display)
			return
		end
		PlayerData.AddTool(player, recipe.Id)
		giveTool(player, recipe.Id)
	elseif recipe.Kind == "Cook" then
		local root = rootOf(player)
		if not root or not Builds.NearCampfire(root.Position, survival.CampfireRadius) then
			notify(player, "Встань рядом с костром")
			return
		end
		for item, amount in recipe.Gives do
			PlayerData.AddItem(player, item, amount)
		end
	elseif not Builds.Place(player, recipe.Id) then
		notify(player, "Здесь нельзя строить")
		return
	end

	for item, amount in recipe.Cost do
		PlayerData.AddItem(player, item, -amount)
	end
	notify(player, "Готово: " .. recipe.Display)
end

local function eat(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	for _, food in Config.Food do
		if PlayerData.GetItem(player, food.Item) > 0 then
			PlayerData.AddItem(player, food.Item, -1)
			local hunger = (player:GetAttribute("Hunger") :: number?) or 0
			player:SetAttribute("Hunger", math.min(survival.MaxHunger, hunger + food.Hunger))
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + food.Heal)
			notify(player, "Съедено: " .. Config.ItemNames[food.Item])
			return
		end
	end
	notify(player, "Нечего есть")
end

local lastAction: { [Player]: number } = {}

Remotes.Action.OnServerEvent:Connect(function(player: Player, action: unknown, arg: unknown, extra: unknown)
	local now = os.clock()
	if now - (lastAction[player] or 0) < 0.15 then
		return
	end
	lastAction[player] = now

	if action == "Craft" and typeof(arg) == "string" then
		craft(player, arg)
	elseif action == "Eat" then
		eat(player)
	elseif action == "Store" then
		Containers.Transfer(player, arg, extra, true)
	elseif action == "Take" then
		Containers.Transfer(player, arg, extra, false)
	elseif action == "CloseContainer" then
		Containers.StopViewing(player, arg)
	end
end)

local function spawnPlayer(player: Player)
	if player.Parent then
		player:LoadCharacterAsync()
	end
end

local function onCharacter(player: Player, character: Model)
	player:SetAttribute("Hunger", survival.MaxHunger)

	if Shop.Has(player, "VIP") then
		PlayerData.AddTool(player, "StoneHatchet")
	end
	giveTool(player, "Rock")
	for _, id in PlayerData.OwnedTools(player) do
		giveTool(player, id)
	end

	local spot = WorldGen.RandomSurface({ Enum.Material.Sand }, 200)
		or WorldGen.RandomSurface({ Enum.Material.Grass }, 200)
	if spot then
		character:WaitForChild("HumanoidRootPart")
		character:PivotTo(CFrame.new(spot + Vector3.new(0, 4, 0)))
	end

	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.Died:Connect(function()
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local items = PlayerData.TakeAllItems(player)
		PlayerData.ClearTools(player)
		if root then
			Containers.DropLootBag(root.Position, items, player.Name)
		end
		notify(player, "Ты погиб. Твой рюкзак остался на месте смерти.")
		task.delay(survival.RespawnDelay, spawnPlayer, player)
	end)
end

local function onPlayer(player: Player)
	PlayerData.Load(player)
	Shop.Load(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	spawnPlayer(player)
end

Lighting.ClockTime = 8
local atmosphere = Instance.new("Atmosphere")
atmosphere.Density = 0.3
atmosphere.Haze = 1
atmosphere.Parent = Lighting

WorldGen.Generate()
Resources.SpawnAll()
Animals.SpawnAll()
Animals.Run()
Shop.Init()

Players.PlayerAdded:Connect(onPlayer)
Players.PlayerRemoving:Connect(function(player)
	lastAction[player] = nil
	PlayerData.Save(player)
	PlayerData.Remove(player)
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end

game:BindToClose(function()
	for _, player in Players:GetPlayers() do
		PlayerData.Save(player)
	end
end)

task.spawn(function()
	while true do
		task.wait(Config.Save.AutosaveInterval)
		PlayerData.SaveAll(Players:GetPlayers())
	end
end)

local hungerTimer = 0
while true do
	local dt = task.wait(1)
	Lighting.ClockTime = (Lighting.ClockTime + dt * 24 / Config.DayLengthSeconds) % 24

	hungerTimer += dt
	local drain = hungerTimer >= survival.HungerDrainEvery
	if drain then
		hungerTimer = 0
	end

	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = rootOf(player)
		if humanoid and root and humanoid.Health > 0 then
			local hunger = (player:GetAttribute("Hunger") :: number?) or survival.MaxHunger
			if drain then
				hunger = math.max(0, hunger - survival.HungerDrainAmount)
				player:SetAttribute("Hunger", hunger)
			end
			if hunger <= 0 then
				humanoid:TakeDamage(survival.StarveDamage)
			end
			if Builds.NearCampfire(root.Position, survival.CampfireRadius) then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + survival.CampfireHeal)
			end
		end
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local PlayerData = {}

type Entry = {
	Items: { [string]: number },
	Tools: { [string]: boolean },
	CanSave: boolean,
}

local entries: { [Player]: Entry } = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Save.DataStore)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] Сохранение отключено: " .. tostring(result))
	end
end

local function key(player: Player): string
	return "player_" .. player.UserId
end

local function sync(player: Player, entry: Entry)
	for _, item in Config.Items do
		player:SetAttribute(item, entry.Items[item])
	end
end

function PlayerData.Load(player: Player)
	local saved = nil
	local canSave = store ~= nil
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			saved = result
		else
			-- Saving now would overwrite real progress with an empty inventory.
			canSave = false
			warn("[PlayerData] Не удалось загрузить " .. player.Name .. ": " .. tostring(result))
		end
	end

	local entry: Entry = { Items = {}, Tools = {}, CanSave = canSave }
	for _, item in Config.Items do
		entry.Items[item] = saved and saved.Items and tonumber(saved.Items[item]) or 0
	end
	if saved and saved.Tools then
		for id in Config.Tools do
			if saved.Tools[id] then
				entry.Tools[id] = true
			end
		end
	end

	entries[player] = entry
	sync(player, entry)
end

function PlayerData.Save(player: Player)
	local entry = entries[player]
	if not entry or not entry.CanSave or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), { Items = entry.Items, Tools = entry.Tools }, { player.UserId })
	end)
	if not ok then
		warn("[PlayerData] Не удалось сохранить " .. player.Name .. ": " .. tostring(err))
	end
end

function PlayerData.Remove(player: Player)
	entries[player] = nil
end

function PlayerData.GetItem(player: Player, item: string): number
	local entry = entries[player]
	return entry and entry.Items[item] or 0
end

function PlayerData.AddItem(player: Player, item: string, amount: number)
	local entry = entries[player]
	if not entry or entry.Items[item] == nil then
		return
	end
	entry.Items[item] = math.max(0, entry.Items[item] + amount)
	player:SetAttribute(item, entry.Items[item])
end

function PlayerData.CanAfford(player: Player, cost: { [string]: number }): boolean
	for item, amount in cost do
		if PlayerData.GetItem(player, item) < amount then
			return false
		end
	end
	return true
end

-- Empties the inventory and returns what was in it.
function PlayerData.TakeAllItems(player: Player): { [string]: number }
	local entry = entries[player]
	local taken = {}
	if not entry then
		return taken
	end
	for item, amount in entry.Items do
		if amount > 0 then
			taken[item] = amount
		end
		entry.Items[item] = 0
	end
	sync(player, entry)
	return taken
end

function PlayerData.OwnedTools(player: Player): { string }
	local entry = entries[player]
	local list = {}
	if entry then
		for id in entry.Tools do
			table.insert(list, id)
		end
	end
	return list
end

function PlayerData.HasTool(player: Player, id: string): boolean
	local entry = entries[player]
	return entry ~= nil and entry.Tools[id] == true
end

function PlayerData.AddTool(player: Player, id: string)
	local entry = entries[player]
	if entry then
		entry.Tools[id] = true
	end
end

function PlayerData.ClearTools(player: Player)
	local entry = entries[player]
	if entry then
		table.clear(entry.Tools)
	end
end

function PlayerData.SaveAll(players: { Player })
	for _, player in players do
		task.spawn(PlayerData.Save, player)
	end
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Resources</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Targeting = require(script.Parent.Targeting)
local WorldGen = require(script.Parent.WorldGen)

local Resources = {}

local rng = Random.new()
local folder = Instance.new("Folder")
folder.Name = "Resources"
folder.Parent = workspace

local basePivots: { [Model]: CFrame } = {}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

local builders = {}

function builders.Tree(model: Model, ground: Vector3)
	local height = rng:NextNumber(12, 18)
	local trunk = part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 2.2, 2.2),
		CFrame = CFrame.new(ground + Vector3.new(0, height / 2 - 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(105, 72, 45),
	})
	trunk.Parent = model

	local leafSize = rng:NextNumber(8, 12)
	local leaves = part({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(leafSize, leafSize, leafSize),
		CFrame = CFrame.new(ground + Vector3.new(0, height, 0)),
		Material = Enum.Material.Grass,
		Color = Color3.fromRGB(58, 125, 50):Lerp(Color3.fromRGB(90, 150, 60), rng:NextNumber()),
	})
	leaves.Parent = model
end

function builders.Rock(model: Model, ground: Vector3)
	local size = Vector3.new(rng:NextNumber(4, 7), rng:NextNumber(3, 5), rng:NextNumber(4, 7))
	local rotation = CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
	local stone = part({
		Name = "Stone",
		Size = size,
		CFrame = CFrame.new(ground + Vector3.new(0, size.Y / 2 - 1, 0)) * rotation,
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(120, 120, 125),
	})
	stone.Parent = model
end

function builders.Bush(model: Model, ground: Vector3)
	local bush = part({
		Name = "Bush",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(4.5, 4.5, 4.5),
		CFrame = CFrame.new(ground + Vector3.new(0, 1.5, 0)),
		Material = Enum.Material.Grass,
		Color = Color3.fromRGB(45, 105, 45),
	})
	bush.Parent = model

	for _ = 1, 6 do
		local direction = rng:NextUnitVector()
		local berry = part({
			Name = "Berry",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.6, 0.6, 0.6),
			CFrame = CFrame.new(bush.Position + direction * 2.2),
			Material = Enum.Material.SmoothPlastic,
			Color = Color3.fromRGB(200, 30, 50),
			CanCollide = false,
		})
		berry.Parent = model
	end
end

local spawnMaterials = {
	Tree = { Enum.Material.Grass },
	Rock = { Enum.Material.Grass, Enum.Material.Rock, Enum.Material.Sand },
	Bush = { Enum.Material.Grass },
}

function Resources.Spawn(kind: string)
	local ground = WorldGen.RandomSurface(spawnMaterials[kind])
	if not ground then
		return
	end

	local model = Instance.new("Model")
	model.Name = kind
	builders[kind](model, ground)
	model.WorldPivot = CFrame.new(ground)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("Amount", Config.Resources[kind].Amount)
	model.Parent = folder
	basePivots[model] = model.WorldPivot
end

function Resources.SpawnAll()
	for kind, def in Config.Resources do
		for _ = 1, def.Count do
			Resources.Spawn(kind)
		end
	end
end

-- Nearest node in front of the character within `range` studs.
function Resources.FindTarget(root: BasePart, range: number): Model?
	local best, bestDistance = nil, math.huge
	for _, model in folder:GetChildren() do
		local distance = Targeting.InFront(root, model:GetPivot().Position, range)
		if distance and distance < bestDistance then
			best, bestDistance = model, distance
		end
	end
	return best
end

local function shake(model: Model)
	local base = basePivots[model]
	if not base then
		return
	end
	task.spawn(function()
		for _ = 1, 4 do
			if not model.Parent then
				return
			end
			model:PivotTo(base * CFrame.Angles(math.rad(rng:NextNumber(-3, 3)), 0, math.rad(rng:NextNumber(-3, 3))))
			task.wait(0.03)
		end
		if model.Parent then
			model:PivotTo(base)
		end
	end)
end

-- Takes resources from a node using a tool's yield table. Returns the item and amount gathered.
function Resources.Hit(model: Model, yield: { [string]: number }): (string?, number)
	local kind = model:GetAttribute("Kind")
	local def = Config.Resources[kind]
	if not def then
		return nil, 0
	end

	local remaining = model:GetAttribute("Amount") or 0
	local gathered = math.min(yield[def.Item] or 0, remaining)
	if gathered <= 0 then
		return def.Item, 0
	end

	remaining -= gathered
	if remaining <= 0 then
		basePivots[model] = nil
		model:Destroy()
		task.delay(def.Respawn, Resources.Spawn, kind)
	else
		model:SetAttribute("Amount", remaining)
		shake(model)
	end
	return def.Item, gathered
end

return Resources
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Remotes = ReplicatedStorage.Remotes

local Shop = {}

-- Ownership is mirrored to a player attribute named after the pass key, e.g. "VIP".
function Shop.Has(player: Player, passKey: string): boolean
	return player:GetAttribute(passKey) == true
end

function Shop.Load(player: Player)
	for _, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			player:SetAttribute(pass.Key, ok and owns == true)
		end
	end
end

function Shop.Init()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, pass in Config.GamePasses do
			if pass.Id == passId then
				player:SetAttribute(pass.Key, true)
				Remotes.Notify:FireClient(player, "Спасибо за покупку: " .. pass.Display .. "!")
			end
		end
	end)
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Targeting</string>
          <string name="Source"><![CDATA[local Targeting = {}

-- Horizontal distance to `position` if it is within `range` and roughly in front of `root`.
function Targeting.InFront(root: BasePart, position: Vector3, range: number): number?
	local offset = position - root.Position
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local distance = flat.Magnitude
	if distance > range or math.abs(offset.Y) > 15 then
		return nil
	end
	if distance > 3 and root.CFrame.LookVector:Dot(flat.Unit) < 0.2 then
		return nil
	end
	return distance
end

return Targeting
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Tools</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Tools = {}

local stoneColor = Color3.fromRGB(125, 125, 130)
local woodColor = Color3.fromRGB(110, 75, 45)

local function attach(handle: BasePart, piece: BasePart, offset: CFrame)
	piece.CFrame = handle.CFrame * offset
	piece.CanCollide = false
	piece.Massless = true
	piece.Parent = handle.Parent
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = piece
	weld.Parent = piece
end

local function newPart(size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.Massless = true
	return p
end

local looks = {}

function looks.Rock(tool: Tool)
	local handle = newPart(Vector3.new(1.3, 1.1, 1.3), stoneColor, Enum.Material.Slate)
	handle.Name = "Handle"
	handle.Parent = tool
	tool.Grip = CFrame.new(0, 0, 0)
end

-- In grip space +Y is up and -Z is forward, so the shaft runs along Y with the head on top.
local function stickWithHead(tool: Tool, headSize: Vector3, headOffset: CFrame)
	local handle = newPart(Vector3.new(0.35, 3.4, 0.35), woodColor, Enum.Material.Wood)
	handle.Name = "Handle"
	handle.Parent = tool
	attach(handle, newPart(headSize, stoneColor, Enum.Material.Slate), headOffset)
	tool.Grip = CFrame.new(0, -1.1, 0) * CFrame.Angles(math.rad(20), 0, 0)
end

function looks.StoneHatchet(tool: Tool)
	stickWithHead(tool, Vector3.new(0.3, 1, 1.3), CFrame.new(0, 1.25, -0.6))
end

function looks.StonePickaxe(tool: Tool)
	stickWithHead(tool, Vector3.new(0.35, 0.45, 2.8), CFrame.new(0, 1.5, 0))
end

function Tools.Create(id: string, onSwing: (Player, Tool, string) -> ()): Tool
	local def = Config.Tools[id]
	local tool = Instance.new("Tool")
	tool.Name = def.Display
	tool.CanBeDropped = false
	tool:SetAttribute("ToolId", id)
	looks[id](tool)

	local lastSwing = 0
	tool.Activated:Connect(function()
		local now = os.clock()
		if now - lastSwing < def.Cooldown then
			return
		end
		lastSwing = now

		local player = game:GetService("Players"):GetPlayerFromCharacter(tool.Parent)
		if not player then
			return
		end

		-- The default Animate script plays its slash animation when it sees this value.
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool

		onSwing(player, tool, id)
	end)

	return tool
end

return Tools
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">WorldGen</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldGen = {}

local island = Config.Island
local rng = Random.new()
local seed = rng:NextNumber(0, 10000)

local function heightAt(x: number, z: number): number
	local d = math.sqrt(x * x + z * z) / island.Radius
	local falloff = 1 - d * d
	local noise = math.noise(x / 90, z / 90, seed) * 0.7 + math.noise(x / 30, z / 30, seed + 17) * 0.3
	return falloff * island.MaxHeight + noise * 10 - 3
end

local function surfaceMaterial(h: number): Enum.Material
	if h < island.SeaLevel + 2.5 then
		return Enum.Material.Sand
	elseif h > island.MaxHeight * 0.85 then
		return Enum.Material.Rock
	end
	return Enum.Material.Grass
end

function WorldGen.Generate()
	local terrain = workspace.Terrain
	terrain:Clear()

	local extent = island.Radius * 1.4
	local cell = island.Cell
	local floor = island.SeaFloor
	local waterHeight = island.SeaLevel - floor
	local chunk = 256

	for x = -extent - chunk, extent + chunk, chunk do
		for z = -extent - chunk, extent + chunk, chunk do
			terrain:FillBlock(
				CFrame.new(x, floor + waterHeight / 2, z),
				Vector3.new(chunk, waterHeight, chunk),
				Enum.Material.Water
			)
		end
	end

	for x = -extent, extent, cell do
		for z = -extent, extent, cell do
			local h = heightAt(x, z)
			if h > floor + 2 then
				terrain:FillBlock(
					CFrame.new(x, (floor + h) / 2, z),
					Vector3.new(cell, h - floor, cell),
					Enum.Material.Ground
				)
				terrain:FillBlock(CFrame.new(x, h - 2, z), Vector3.new(cell, 4, cell), surfaceMaterial(h))
			end
		end
		task.wait()
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = { workspace.Terrain }
rayParams.IgnoreWater = true

-- Returns a random point on dry land whose surface material is in `materials`.
function WorldGen.RandomSurface(materials: { Enum.Material }, attempts: number?): Vector3?
	for _ = 1, attempts or 30 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = math.sqrt(rng:NextNumber()) * island.Radius
		local origin = Vector3.new(math.cos(angle) * radius, 200, math.sin(angle) * radius)
		local hit = workspace:Raycast(origin, Vector3.new(0, -400, 0), rayParams)
		if hit and hit.Position.Y > island.SeaLevel + 0.5 and table.find(materials, hit.Material) then
			return hit.Position
		end
	end
	return nil
end

function WorldGen.GroundBelow(position: Vector3): Vector3?
	local hit = workspace:Raycast(position + Vector3.new(0, 20, 0), Vector3.new(0, -80, 0), rayParams)
	return hit and hit.Position
end

return WorldGen
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="20">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="21">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- An empty script named "Health" replaces Roblox's default health regeneration,
-- so players heal only by eating or resting by a campfire.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="25">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local font = Enum.Font.SourceSansBold

local gui = Instance.new("ScreenGui")
gui.Name = "HUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent: Instance, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
end

local function label(parent: Instance, text: string, size: number): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = font
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextSize = size
	l.Text = text
	l.TextStrokeTransparency = 0.6
	l.Parent = parent
	return l
end

-- Inventory

local inventory = Instance.new("Frame")
inventory.Position = UDim2.fromOffset(16, 60)
inventory.Size = UDim2.fromOffset(190, 34 * #Config.Items + 16)
inventory.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
inventory.BackgroundTransparency = 0.35
inventory.Parent = gui
corner(inventory)

local itemLabels: { [string]: TextLabel } = {}
for i, item in Config.Items do
	local l = label(inventory, "", 22)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Position = UDim2.fromOffset(14, 8 + (i - 1) * 34)
	l.Size = UDim2.new(1, -28, 0, 32)
	itemLabels[item] = l
end

-- Health and hunger bars

local function bar(y: number, color: Color3, title: string): (Frame, TextLabel)
	local back = Instance.new("Frame")
	back.AnchorPoint = Vector2.new(0.5, 1)
	back.Position = UDim2.new(0.5, 0, 1, y)
	back.Size = UDim2.fromOffset(320, 24)
	back.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	back.BackgroundTransparency = 0.25
	back.Parent = gui
	corner(back, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.Parent = back
	corner(fill, 6)

	local text = label(back, title, 18)
	text.Size = UDim2.fromScale(1, 1)
	text.ZIndex = 2
	return fill, text
end

local healthFill, healthText = bar(-48, Color3.fromRGB(200, 55, 55), "Здоровье")
local hungerFill, hungerText = bar(-18, Color3.fromRGB(220, 140, 40), "Голод")

local function setBar(fill: Frame, text: TextLabel, title: string, value: number, max: number)
	local ratio = math.clamp(value / max, 0, 1)
	fill.Size = UDim2.fromScale(ratio, 1)
	fill.Visible = ratio > 0
	text.Text = string.format("%s: %d", title, math.ceil(value))
end

local function watchHumanoid(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local function update()
		setBar(healthFill, healthText, "Здоровье", humanoid.Health, humanoid.MaxHealth)
	end
	humanoid.HealthChanged:Connect(update)
	update()
end

player.CharacterAdded:Connect(watchHumanoid)
if player.Character then
	task.spawn(watchHumanoid, player.Character)
end

-- Crafting

local craftPanel = Instance.new("Frame")
craftPanel.AnchorPoint = Vector2.new(1, 0.5)
craftPanel.Position = UDim2.new(1, -16, 0.5, 0)
craftPanel.Size = UDim2.fromOffset(320, 56 + #Config.Recipes * 64)
craftPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
craftPanel.BackgroundTransparency = 0.2
craftPanel.Visible = false
craftPanel.Parent = gui
corner(craftPanel)

local craftTitle = label(craftPanel, "Крафт", 26)
craftTitle.Size = UDim2.new(1, 0, 0, 44)

local function costText(cost: { [string]: number }): string
	local parts = {}
	for _, item in Config.Items do
		if cost[item] then
			table.insert(parts, string.format("%s %d", Config.ItemNames[item], cost[item]))
		end
	end
	return table.concat(parts, ", ")
end

local recipeButtons: { [TextButton]: { [string]: number } } = {}
for i, recipe in Config.Recipes do
	local button = Instance.new("TextButton")
	button.Position = UDim2.fromOffset(12, 44 + (i - 1) * 64)
	button.Size = UDim2.new(1, -24, 0, 56)
	button.Font = font
	button.TextSize = 20
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Text = recipe.Display .. "\n" .. costText(recipe.Cost)
	button.AutoButtonColor = true
	button.Parent = craftPanel
	corner(button, 6)
	button.Activated:Connect(function()
		Remotes.Action:FireServer("Craft", recipe.Id)
	end)
	recipeButtons[button] = recipe.Cost
end

local function refreshInventory()
	for item, l in itemLabels do
		l.Text = string.format("%s: %d", Config.ItemNames[item], player:GetAttribute(item) or 0)
	end
	for button, cost in recipeButtons do
		local affordable = true
		for item, amount in cost do
			if (player:GetAttribute(item) or 0) < amount then
				affordable = false
			end
		end
		button.BackgroundColor3 = affordable and Color3.fromRGB(60, 120, 60) or Color3.fromRGB(70, 70, 75)
	end
end

local function refreshHunger()
	setBar(hungerFill, hungerText, "Голод", player:GetAttribute("Hunger") or 0, Config.Survival.MaxHunger)
end

for _, item in Config.Items do
	player:GetAttributeChangedSignal(item):Connect(refreshInventory)
end
player:GetAttributeChangedSignal("Hunger"):Connect(refreshHunger)
refreshInventory()
refreshHunger()

-- Notifications

local feed = Instance.new("Frame")
feed.AnchorPoint = Vector2.new(0.5, 1)
feed.Position = UDim2.new(0.5, 0, 1, -110)
feed.Size = UDim2.fromOffset(400, 200)
feed.BackgroundTransparency = 1
feed.Parent = gui

local layout = Instance.new("UIListLayout")
layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Padding = UDim.new(0, 4)
layout.Parent = feed

local function showNotice(text: string)
	local l = label(feed, text, 22)
	l.Size = UDim2.new(1, 0, 0, 26)
	task.delay(1.5, function()
		local tween = TweenService:Create(l, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 })
		tween.Completed:Connect(function()
			l:Destroy()
		end)
		tween:Play()
	end)
end

Remotes.Notify.OnClientEvent:Connect(showNotice)

local function button(parent: Instance, text: string, color: Color3): TextButton
	local b = Instance.new("TextButton")
	b.Font = font
	b.TextSize = 18
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.BackgroundColor3 = color
	b.Parent = parent
	corner(b, 6)
	return b
end

-- Chests and loot bags

local rowHeight = 40
local containerPanel = Instance.new("Frame")
containerPanel.AnchorPoint = Vector2.new(0.5, 0.5)
containerPanel.Position = UDim2.fromScale(0.5, 0.45)
containerPanel.Size = UDim2.fromOffset(460, 110 + #Config.Items * rowHeight)
containerPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
containerPanel.BackgroundTransparency = 0.15
containerPanel.Visible = false
containerPanel.Parent = gui
corner(containerPanel)

local containerTitle = label(containerPanel, "", 24)
containerTitle.Size = UDim2.new(1, 0, 0, 40)

local header = label(containerPanel, "у тебя / внутри", 16)
header.Position = UDim2.fromOffset(150, 34)
header.Size = UDim2.fromOffset(110, 20)
header.TextTransparency = 0.3

local openId: string? = nil
local openItems: { [string]: number } = {}
local openModel: Model? = nil
local countLabels: { [string]: TextLabel } = {}

for i, item in Config.Items do
	local y = 56 + (i - 1) * rowHeight
	local name = label(containerPanel, Config.ItemNames[item], 20)
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.Position = UDim2.fromOffset(16, y)
	name.Size = UDim2.fromOffset(140, rowHeight - 6)

	local count = label(containerPanel, "", 20)
	count.Position = UDim2.fromOffset(150, y)
	count.Size = UDim2.fromOffset(110, rowHeight - 6)
	countLabels[item] = count

	local store = button(containerPanel, "Положить", Color3.fromRGB(70, 90, 140))
	store.Position = UDim2.fromOffset(266, y)
	store.Size = UDim2.fromOffset(90, rowHeight - 8)
	store.Activated:Connect(function()
		Remotes.Action:FireServer("Store", openId, item)
	end)

	local take = button(containerPanel, "Взять", Color3.fromRGB(60, 120, 60))
	take.Position = UDim2.fromOffset(362, y)
	take.Size = UDim2.fromOffset(82, rowHeight - 8)
	take.Activated:Connect(function()
		Remotes.Action:FireServer("Take", openId, item)
	end)
end

local closeButton = button(containerPanel, "Закрыть", Color3.fromRGB(110, 50, 50))
closeButton.AnchorPoint = Vector2.new(0.5, 1)
closeButton.Position = UDim2.new(0.5, 0, 1, -10)
closeButton.Size = UDim2.fromOffset(140, 34)

local function refreshContainer()
	if not openId then
		return
	end
	for item, count in countLabels do
		count.Text = string.format("%d / %d", player:GetAttribute(item) or 0, openItems[item] or 0)
	end
end

local function closeContainer(tellServer: boolean)
	if openId and tellServer then
		Remotes.Action:FireServer("CloseContainer", openId)
	end
	openId, openModel = nil, nil
	containerPanel.Visible = false
end

closeButton.Activated:Connect(function()
	closeContainer(true)
end)

for _, item in Config.Items do
	player:GetAttributeChangedSignal(item):Connect(refreshContainer)
end

Remotes.Container.OnClientEvent:Connect(function(action: string, id: string, items: any, title: string?, model: Model?)
	if action == "Open" then
		openId, openItems, openModel = id, items, model
		containerTitle.Text = title or ""
		containerPanel.Visible = true
		refreshContainer()
	elseif action == "Update" and id == openId then
		openItems = items
		refreshContainer()
	elseif action == "Close" and id == openId then
		closeContainer(false)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.3)
		if openId then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local model = openModel
			if not root or not model or not model.Parent or (model:GetPivot().Position - root.Position).Magnitude > 14 then
				closeContainer(true)
			end
		end
	end
end)

-- Shop

local shopPanel = Instance.new("Frame")
shopPanel.AnchorPoint = Vector2.new(0.5, 0.5)
shopPanel.Position = UDim2.fromScale(0.5, 0.45)
shopPanel.Size = UDim2.fromOffset(420, 100 + #Config.GamePasses * 90)
shopPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
shopPanel.BackgroundTransparency = 0.15
shopPanel.Visible = false
shopPanel.Parent = gui
corner(shopPanel)

local shopTitle = label(shopPanel, "Магазин", 26)
shopTitle.Size = UDim2.new(1, 0, 0, 44)

local buyButtons: { [string]: TextButton } = {}

for i, pass in Config.GamePasses do
	local y = 48 + (i - 1) * 90
	local title = label(shopPanel, pass.Display, 22)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Position = UDim2.fromOffset(16, y)
	title.Size = UDim2.fromOffset(250, 26)

	local description = label(shopPanel, pass.Description, 16)
	description.TextXAlignment = Enum.TextXAlignment.Left
	description.TextYAlignment = Enum.TextYAlignment.Top
	description.TextWrapped = true
	description.Position = UDim2.fromOffset(16, y + 28)
	description.Size = UDim2.fromOffset(260, 50)

	local buy = button(shopPanel, "Купить", Color3.fromRGB(200, 150, 40))
	buy.Position = UDim2.fromOffset(290, y + 14)
	buy.Size = UDim2.fromOffset(114, 40)
	buy.Activated:Connect(function()
		if player:GetAttribute(pass.Key) then
			return
		end
		if pass.Id == 0 then
			showNotice("Этот Game Pass ещё не настроен (Config.GamePasses)")
			return
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end)
	buyButtons[pass.Key] = buy
end

local shopClose = button(shopPanel, "Закрыть", Color3.fromRGB(110, 50, 50))
shopClose.AnchorPoint = Vector2.new(0.5, 1)
shopClose.Position = UDim2.new(0.5, 0, 1, -10)
shopClose.Size = UDim2.fromOffset(140, 34)
shopClose.Activated:Connect(function()
	shopPanel.Visible = false
end)

local shopButton = button(gui, "Магазин", Color3.fromRGB(200, 150, 40))
shopButton.AnchorPoint = Vector2.new(1, 0)
shopButton.Position = UDim2.new(1, -16, 0, 60)
shopButton.Size = UDim2.fromOffset(120, 38)
shopButton.TextSize = 20
shopButton.Activated:Connect(function()
	shopPanel.Visible = not shopPanel.Visible
end)

local vipBadge = label(gui, "VIP", 22)
vipBadge.Position = UDim2.fromOffset(16, 70 + inventory.Size.Y.Offset)
vipBadge.Size = UDim2.fromOffset(60, 26)
vipBadge.TextColor3 = Color3.fromRGB(255, 200, 60)
vipBadge.Visible = false

local function refreshPasses()
	for _, pass in Config.GamePasses do
		local owned = player:GetAttribute(pass.Key) == true
		buyButtons[pass.Key].Text = owned and "Куплено" or "Купить"
		buyButtons[pass.Key].AutoButtonColor = not owned
	end
	vipBadge.Visible = player:GetAttribute("VIP") == true
end

for _, pass in Config.GamePasses do
	player:GetAttributeChangedSignal(pass.Key):Connect(refreshPasses)
end
refreshPasses()

-- Controls

local hint = label(gui, "ЛКМ — бить   |   C — крафт   |   F — поесть   |   E — открыть", 18)
hint.AnchorPoint = Vector2.new(0.5, 1)
hint.Position = UDim2.new(0.5, 0, 1, -78)
hint.Size = UDim2.fromOffset(600, 24)
hint.TextTransparency = 0.2

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.C then
		craftPanel.Visible = not craftPanel.Visible
	elseif input.KeyCode == Enum.KeyCode.F then
		Remotes.Action:FireServer("Eat")
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>