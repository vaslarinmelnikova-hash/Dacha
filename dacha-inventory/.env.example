# Supabase project that backs the inventory (Project Settings → API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional. A free key from https://ocr.space/ocrapi/freekey turns on label reading through
# that service, which handles glare, ribbed paper and curved bottles that the on-device
# reader cannot. Leave it unset and photos never leave the phone, but expect most labels to
# come back unreadable.
VITE_OCR_API_KEY=
